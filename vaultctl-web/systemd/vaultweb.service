[Unit]
Description=vaultctl-web frontend (optional) (Svelte/Vite)
After=network.target vaultctl.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/projects/vaultctl/vaultctl-web
Environment="PORT=8788"
Environment="VAULT_URL=http://127.0.0.1:8787"
ExecStartPre=/bin/mkdir -p /home/admin/projects/vaultctl/vaultctl-web/data/logs
ExecStart=/usr/bin/python3 /home/admin/projects/vaultctl/vaultctl-web/serve.py
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/admin/projects/vaultctl/vaultctl-web/serve.log
StandardError=append:/home/admin/projects/vaultctl/vaultctl-web/serve.log

[Install]
WantedBy=multi-user.target